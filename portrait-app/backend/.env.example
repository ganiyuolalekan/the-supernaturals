# Gemini (Google AI) — get keys at https://aistudio.google.com/app/apikey
# One key from a project with billing funded. GEMINI_API_KEYS (comma-separated,
# tried in order with failover) is also supported and takes precedence.
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_API_KEYS=key1,key2,key3
#
# Image model. There is NO free image tier on any current Gemini image model —
# every one of them reports free_tier_requests limit: 0. Billing is required.
#   gemini-2.5-flash-image       ~$0.039/image  ⚠ RETIRED 2 OCT 2026
#   gemini-3.1-flash-image       ~$0.045/image  (successor of the above; verify with GET /debug/gemini)
#   gemini-3.1-flash-lite-image  ~$0.0336/image (cheapest, but lower quality)
# The original free-tier model (gemini-2.5-flash-image-preview) was retired
# 15 Jan 2026. Do not switch to gemini-3-pro-image / nano-banana-pro without
# redoing your budget — they cost several times more per image.
# Prices: ai.google.dev/gemini-api/docs/pricing
GEMINI_MODEL=gemini-3.1-flash-image

# ── Campaign budget controls ────────────────────────────────────────────────
# Service-wide ceiling on SUCCESSFUL generations, per weekday. Once the day's
# ceiling is hit, generation stops until the next open day and the app shows
# 'come back tomorrow'. NOT bypassed by RATE_LIMIT_DISABLED — it guards money.
# Format: <weekday>:<cap> (Mon=0 … Sun=6). Example: Sat 120, Sun 30, Mon 50 = 5:120,6:30,0:50
# Blank = every day uses GLOBAL_DAILY_IMAGE_CAP.
DAILY_IMAGE_CAPS=

# Ceiling for any weekday not listed above. 0 = uncapped (close a day with
# CLOSED_WEEKDAYS, never with a cap of 0).
GLOBAL_DAILY_IMAGE_CAP=40

# Days the app is closed entirely — no generation, scene locked, modal shown.
# date.weekday(): Mon=0 Tue=1 Wed=2 Thu=3 Fri=4 Sat=5 Sun=6. Blank = never.
# e.g. 2,3,4 closes Wed–Fri.
CLOSED_WEEKDAYS=

# Timezone the campaign runs in — decides when a closed day starts and when the
# daily cap resets. Any IANA name; falls back to UTC if invalid.
APP_TIMEZONE=UTC

# Local testing: set to true to bypass Supabase + the per-IP limits (2 per day
# + 5 min cooldown) so you can generate freely. Leave blank/unset in prod.
# NOTE: does NOT bypass GLOBAL_DAILY_IMAGE_CAP or CLOSED_WEEKDAYS.
RATE_LIMIT_DISABLED=

# Supabase — get at https://supabase.com (free tier)
# Persists per-IP rate limits (2 generations/day + 5 min cooldown) and the
# service-wide daily cap counter across Render restarts. The cap counter reuses
# the same `rate_limits` table under the reserved ip "__global__" — no extra
# schema needed. No images or personal data are stored.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Concurrency regulator — caps simultaneous Gemini calls during traffic bursts
MAX_CONCURRENT_GENERATIONS=3
MAX_QUEUE_DEPTH=12

# ── Event-day attendance (/attend_event) ────────────────────────────────────
# Apps Script web app bound to the registration sheet (backend/apps_script/
# Attendance.gs; setup steps in DEPLOY.md). Secret must match the script property.
ATTENDANCE_SCRIPT_URL=
ATTENDANCE_SCRIPT_SECRET=
# Local demo only: read the sheet's public CSV and keep check-ins in memory,
# never writing to the live sheet.
ATTENDANCE_DEMO=
ATTENDANCE_SHEET_ID=

# Attendance chart: the "home" group counted separately, and the regex that matches
# how people type its name in the registration sheet (see attendance.py). Blank = none.
HOME_ORG_NAME=Home Organisation
HOME_ORG_PATTERN=
# Which day the app is "open", scene weeks, etc.
LAUNCH_DATE=2027-01-01
# Vault (private owner path): leave blank to disable. See vault.py to generate the hash.
VAULT_KEY_HASH=
