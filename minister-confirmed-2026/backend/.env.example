# Gemini (Google AI) — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Leave blank to auto-try all candidate models
GEMINI_MODEL=

# Cloudinary — https://cloudinary.com (free tier)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Supabase — https://supabase.com (free tier)
# Table needed: minister_submissions (id, minister_name, minister_title, category, style_id, poster_url, video_url, ip_address, created_at)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key

# Admin dashboard password
ADMIN_PASSWORD=

# CORS — comma-separated allowed frontend origins
CORS_ORIGINS=*
