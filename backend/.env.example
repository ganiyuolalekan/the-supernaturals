# Gemini (Google AI) — get at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-image-preview

# Supabase — get at https://supabase.com (free tier)
# Used only to persist per-IP rate limits (3 generations/day + 5 min cooldown)
# across Render restarts. No images or personal data are stored.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Concurrency regulator — caps simultaneous Gemini calls during traffic bursts
MAX_CONCURRENT_GENERATIONS=3
MAX_QUEUE_DEPTH=12
